# Production environment – copy sang .env.prod và điền giá trị thật
# KHÔNG commit .env.prod vào git

APP_ENV=prod

# Domain (Caddy dùng để cấp TLS)
DOMAIN=ats.example.com

# Phiên bản image (dùng khi build: docker compose ... build)
APP_VERSION=1.0.0

# ── Bảo mật ─────────────────────────────────────────────────────────────────
# Tạo key ngẫu nhiên: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=THAY-BANG-KEY-NGAU-NHIEN-DAI-32-BYTES

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=hr
POSTGRES_PASSWORD=THAY-BANG-MAT-KHAU-MANH
POSTGRES_DB=hr_ats
DATABASE_URL=postgresql+psycopg://hr:THAY-BANG-MAT-KHAU-MANH@db:5432/hr_ats

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Lưu file ─────────────────────────────────────────────────────────────────
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=var/storage
# S3 (bỏ comment và điền nếu dùng S3/MinIO)
# STORAGE_BACKEND=s3
# S3_ENDPOINT=https://s3.example.com
# S3_BUCKET=hr-ats-storage
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# ── LLM ──────────────────────────────────────────────────────────────────────
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=

# Tham số chấm điểm (mặc định)
SCORE_MUST_WEIGHT=0.75
SCORE_PARTIAL_VALUE=0.5
SCORE_HIGH_THRESHOLD=75
SCORE_UNKNOWN_THRESHOLD=0.5
SCORE_MIN_TEXT_LENGTH=300

# ── Embedding ─────────────────────────────────────────────────────────────────
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# ── OCR ──────────────────────────────────────────────────────────────────────
OCR_ENABLED=true
TESSERACT_LANGS=vie+eng

# ── Email gửi ────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=tuyendung@example.com
SMTP_PASSWORD=
SMTP_FROM="Tuyển dụng <tuyendung@example.com>"
SMTP_TLS=true
EMAIL_RATE_LIMIT_PER_HOUR=200

# ── Email nhận CV (IMAP) ─────────────────────────────────────────────────────
IMAP_ENABLED=false
IMAP_HOST=imap.example.com
IMAP_USER=tuyendung@example.com
IMAP_PASSWORD=

# ── Giới hạn ─────────────────────────────────────────────────────────────────
LOGIN_RATE_LIMIT_PER_MINUTE=30
UPLOAD_RATE_LIMIT_PER_MINUTE=20

# ── Tuỳ chỉnh ────────────────────────────────────────────────────────────────
HIRING_UNIT_LABEL="Đơn vị tuyển"
DATA_RETENTION_MONTHS=24
APP_TIMEZONE=Asia/Ho_Chi_Minh
FRONTEND_ORIGIN=https://ats.example.com

# ── Frontend ─────────────────────────────────────────────────────────────────
NEXT_OUTPUT=standalone
NEXT_PUBLIC_API_URL=/api/v1
