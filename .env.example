# Giá trị mẫu cho dev; các API key để trống.
APP_ENV=dev
SECRET_KEY=change-me
DATABASE_URL=postgresql+psycopg://hr:hr@localhost:5432/hr_ats
REDIS_URL=redis://localhost:6379/0

STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=var/storage
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

LLM_PROVIDER=fake
LLM_MODEL=
SCORE_MUST_WEIGHT=0.75
SCORE_PARTIAL_VALUE=0.5
SCORE_HIGH_THRESHOLD=75
SCORE_UNKNOWN_THRESHOLD=0.5
SCORE_MIN_TEXT_LENGTH=300
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
OCR_ENABLED=true
TESSERACT_LANGS=vie+eng

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Tuyển dụng <tuyendung@example.com>"
SMTP_TLS=false
EMAIL_RATE_LIMIT_PER_HOUR=200
LOGIN_RATE_LIMIT_PER_MINUTE=30
UPLOAD_RATE_LIMIT_PER_MINUTE=20
IMAP_ENABLED=false
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

HIRING_UNIT_LABEL="Đơn vị tuyển"
DATA_RETENTION_MONTHS=24
FRONTEND_ORIGIN=http://localhost:3000
APP_TIMEZONE=Asia/Ho_Chi_Minh
