# Giá trị mẫu cho dev; các API key để trống.
APP_ENV=dev
SECRET_KEY=change-me
DATABASE_URL=postgresql+psycopg://hr:hr@localhost:5432/hr_ats
REDIS_URL=redis://localhost:6379/0

STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=var/storage
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

LLM_PROVIDER=fake
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
OCR_ENABLED=true
TESSERACT_LANGS=vie+eng

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Tuyển dụng <tuyendung@example.com>"
SMTP_TLS=false
IMAP_ENABLED=false
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

HIRING_UNIT_LABEL="Đơn vị tuyển"
DATA_RETENTION_MONTHS=24
FRONTEND_ORIGIN=http://localhost:3000
TZ=Asia/Ho_Chi_Minh
