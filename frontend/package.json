{
  "name": "hr-ats-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "overrides": {
    "next": {
      "postcss": "$postcss"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
